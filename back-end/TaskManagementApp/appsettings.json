{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=taskmanagement.db"
  },

  "JwtSettings": {
    "Key": "THIS_KEY_NEEDS_TO_BE_CHANGED_IF_PROJECT_IS_IN_PRODUCTION",
    "Issuer": "TaskManagementApp",
    "Audience": "TaskManagementAppUsers",
    "ExpiryMinutes": 60
  }
}
